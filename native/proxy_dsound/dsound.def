; Export table for proxy_dsound.dll, mirroring the real system dsound.dll.
;
; Needed for two reasons:
;   1. The thunks in dllmain.cpp are __stdcall-shaped; without a .def the linker would
;      export them decorated (_DirectSoundCreate@12 and friends) and popcapgame1.exe's
;      import table would not resolve.
;   2. Ordinals must match the genuine dsound.dll so anything importing by ordinal
;      rather than by name still lands on the right function.
;
; Ordinals captured via `dumpbin /EXPORTS` against the real system dsound.dll.
LIBRARY dsound
EXPORTS
    DirectSoundCreate            @1
    DirectSoundEnumerateA        @2
    DirectSoundEnumerateW        @3
    DllCanUnloadNow              @4
    DllGetClassObject            @5
    DirectSoundCaptureCreate     @6
    DirectSoundCaptureEnumerateA @7
    DirectSoundCaptureEnumerateW @8
    GetDeviceID                  @9
    DirectSoundFullDuplexCreate  @10
    DirectSoundCreate8           @11
    DirectSoundCaptureCreate8    @12
